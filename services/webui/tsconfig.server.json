{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist/server",
    "rootDir": "src/server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    // Required: tsconfig.json lists this project under "references", and TS
    // rejects a referenced project without it (TS6306), which broke
    // `npm run typecheck` entirely.
    "composite": true
  },
  "include": ["src/server"],
  "exclude": ["node_modules"]
}
