{
  "name": "webui",
  "version": "1.0.0",
  "description": "WebUI Shell - Node.js + React frontend",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:client:mocks": "VITE_MOCKS=true vite",
    "dev:server": "tsx watch src/server/index.ts",
    "generate:api": "openapi-typescript ../../openapi/v1.yaml -o src/client/api/schema.d.ts && prettier --write src/client/api/schema.d.ts",
    "lint": "eslint src --no-warn-ignored",
    "lint:fix": "eslint src --fix --no-warn-ignored",
    "screenshots": "node ../../scripts/capture-screenshots.cjs",
    "start": "node dist/server/index.js",
    "test": "jest --watch=false",
    "test:coverage": "jest --coverage",
    "test:e2e": "rm -rf /tmp/playwright-penguincloud && playwright test; status=$?; rm -rf /tmp/playwright-penguincloud; exit $status",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@penguintechinc/react-libs": "1.3.4",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "express": "5.2.1",
    "http-proxy-middleware": "3.0.7",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/express": "5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.0.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.17",
    "ts-jest": "29.4.12",
    "tsx": "4.23.11",
    "typescript": "5.7.2",
    "typescript-eslint": "8.47.0",
    "vite": "6.4.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
