{
  "name": "webui",
  "version": "1.0.0",
  "description": "WebUI Shell - Node.js + React frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint src --no-warn-ignored",
    "lint:fix": "eslint src --fix --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "screenshots": "node ../../scripts/capture-screenshots.cjs"
  },
  "dependencies": {
    "@penguintechinc/react-libs": "1.3.4",
    "axios": "1.18.0",
    "express": "4.22.2",
    "http-proxy-middleware": "3.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.14",
    "@types/react-dom": "18.3.4",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "eslint": "9.16.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.0.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "puppeteer": "23.10.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.47.0",
    "vite": "6.0.3"
  }
}
